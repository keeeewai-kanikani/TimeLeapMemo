export component MainWindow inherits Window {
    title: "TimeLeap Memo (Rust)";
    width: 800px;
    height: 600px;
    background: #ffffff;

    callback pointer-move(point);
    callback pointer-down(point);
    callback pointer-up();
    callback toggle-play();
    callback go-to-now();

    in-out property <float> virtual-time: 0.0;
    in-out property <bool> is-playing: false;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        
        // Drawing Area
        Rectangle {
            background: #f0f0f0;
            border-radius: 4px;
            
            touch-area := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.pointer-down({ x: self.mouse-x, y: self.mouse-y });
                    } else if (event.kind == PointerEventKind.move) {
                        root.pointer-move({ x: self.mouse-x, y: self.mouse-y });
                    } else if (event.kind == PointerEventKind.up) {
                        root.pointer-up();
                    }
                }
            }
        }

        // Bottom Controls
        HorizontalLayout {
            height: 40px;
            spacing: 20px;
            alignment: center;
            
            Text {
                text: "Virtual Time: \{Math.round(root.virtual-time * 100) / 100}";
                vertical-alignment: center;
            }

            PlayButton := Rectangle {
                width: 40px;
                height: 30px;
                background: root.is-playing ? #d40000 : #00d478;
                border-radius: 4px;
                Text {
                    text: root.is-playing ? "PAUSE" : "PLAY";
                    color: white;
                    font-size: 10px;
                }
                TouchArea {
                    clicked => { root.toggle-play() }
                }
            }
            
            NowButton := Rectangle {
                width: 60px;
                height: 30px;
                background: #0078d4;
                border-radius: 4px;
                Text {
                    text: "NOW";
                    color: white;
                }
                TouchArea {
                    clicked => { root.go-to-now() }
                }
            }
        }
    }
}
