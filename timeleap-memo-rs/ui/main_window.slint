import { Button, LineEdit } from "std-widgets.slint";

struct Point {
    x: float,
    y: float,
}

struct StrokeData {
    path_data: string,
    color: color,
    width: length,
    opacity: float,
}

struct SegmentData {
    id: int,
    y: float,
    highlighted: bool,
    waveform-data: string,
}

struct TagData {
    vt: float,
    label: string,
}

component FractalTimeline inherits Rectangle {
    // 1. 各レイヤーの設定
    in property <float> timeline-max: 3600.0;
    in property <float> middle-window-size: 600.0;
    in property <float> micro-window-size: 60.0;
    in property <float> current-vt: 0.0;

    // 2. 外部から提供される比率と座標
    in property <float> macro-ratio: 0.5;
    in property <float> middle-ratio: 0.5;
    in property <float> micro-start: 0.0;
    
    // 操作有効範囲の基準（初期描画を考慮して最小1秒を確保。描画が進めば State.vt-max に広がる）
    property <float> effective-max: Math.max(1.0, State.vt-max);

    callback time-changed(float);
    callback macro-ratio-changed(float);
    callback middle-ratio-changed(float);

    clip: true;
    height: 140px;

    // ==========================================
    // 内部計算：UI描画用のX座標
    // ==========================================
    // 長さ(width)を 1px で割って純粋な数値(float)に変換
    property <float> macro-chunk-x: root.macro-ratio * (root.width / 1px);
    property <float> middle-chunk-x: root.middle-ratio * (root.width / 1px);
    property <float> vt-ratio: (root.current-vt - root.micro-start) / root.micro-window-size;
    property <float> vt-x: root.vt-ratio * (root.width / 1px);
    property <float> chunk-radius: 8.0;

    // ==========================================
    // レイヤー1/2: サーチライト（Path）
    // ==========================================
    Path {
        y: 70px;
        width: 100%;
        height: 50px;
        fill: #2196f333;
        MoveTo {
            x: 0;
            y: 0;
        }

        LineTo {
            x: parent.width / 1px;
            y: 0;
        }

        LineTo {
            x: root.macro-chunk-x + root.chunk-radius;
            y: parent.height / 1px;
        }

        LineTo {
            x: root.macro-chunk-x - root.chunk-radius;
            y: parent.height / 1px;
        }

        Close { }
    }

    Path {
        y: 20px;
        width: 100%;
        height: 50px;
        fill: #2196f344;
        MoveTo {
            x: 0;
            y: 0;
        }

        LineTo {
            x: parent.width / 1px;
            y: 0;
        }

        LineTo {
            x: root.middle-chunk-x + root.chunk-radius;
            y: parent.height / 1px;
        }

        LineTo {
            x: root.middle-chunk-x - root.chunk-radius;
            y: parent.height / 1px;
        }

        Close { }
    }

    // ==========================================
    // レイヤー3: タイムライン（Micro/Middle/Macro）
    // ==========================================

    // Micro (上段)
    Rectangle {
        y: 10px;
        height: 20px;
        width: 100%;
        Rectangle {
            y: 9px;
            width: 100%;
            height: 2px;
            background: #ccc;
        }

        Rectangle {
            x: (root.vt-x * 1px) - 2px;
            y: 0px;
            width: 4px;
            height: 20px;
            border-radius: 2px;
            background: #ff0000;
        }

        TouchArea {
            property <bool> is-pressed: false;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.is-pressed = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.is-pressed = false;
                }
                if (self.is-pressed && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                    let ratio = Math.max(0.0, Math.min(self.mouse-x / self.width, 1.0));
                    let new-vt = root.micro-start + (ratio * root.micro-window-size);
                    root.time-changed(Math.max(0.0, Math.min(new-vt, State.vt-max)));
                }
            }
        }

        Text {
            text: "Micro (\{root.micro-window-size}s)";
            x: 5px;
            y: -10px;
            font-size: 10px;
            color: #666;
        }

        for tag[i] in State.tags: Rectangle {
            property <float> rel-x: (tag.vt - root.micro-start) / root.micro-window-size;
            visible: rel-x >= 0.0 && rel-x <= 1.0;
            x: (rel-x * parent.width / 1px) * 1px - 4px;
            y: 4px;
            width: 8px;
            height: 12px;
            background: #00bcd4;
            border-radius: 2px;
            border-width: 1px;
            border-color: white;

            Text {
                text: tag.label;
                y: 12px + Math.mod(i, 3) * 12px;
                font-size: 10px;
                color: #007c91;
            }
        }
    }

    // Middle (中段)
    Rectangle {
        y: 60px;
        height: 20px;
        width: 100%;
        Rectangle {
            y: 9px;
            width: 100%;
            height: 2px;
            background: #ccc;
        }

        Rectangle {
            x: (root.middle-chunk-x - root.chunk-radius) * 1px;
            y: (10.0 - root.chunk-radius) * 1px;
            width: (root.chunk-radius * 2.0) * 1px;
            height: (root.chunk-radius * 2.0) * 1px;
            border-radius: root.chunk-radius * 1px;
            background: #2196f3;
            border-width: 2px;
            border-color: #fff;
        }

        TouchArea {
            property <bool> is-pressed: false;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.is-pressed = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.is-pressed = false;
                }
                if (self.is-pressed && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                    root.middle-ratio-changed(Math.max(0.0, Math.min(self.mouse-x / self.width, 1.0)));
                }
            }
        }

        Text {
            text: "Middle (\{root.middle-window-size}s)";
            x: 5px;
            y: -10px;
            font-size: 10px;
            color: #666;
        }

        for tag[i] in State.tags: Rectangle {
            property <float> m-center: root.macro-ratio * root.effective-max;
            property <float> m-start: Math.max(0.0, m-center - root.middle-window-size / 2.0);
            property <float> rel-x: (tag.vt - m-start) / root.middle-window-size;
            visible: rel-x >= 0.0 && rel-x <= 1.0;
            x: (rel-x * parent.width / 1px) * 1px - 3px;
            y: 5px;
            width: 6px;
            height: 10px;
            background: #00bcd4;
            opacity: 0.8;
            border-radius: 1px;

            Text {
                text: tag.label;
                y: 10px + Math.mod(i, 3) * 12px;
                font-size: 10px;
                color: #1976d2;
            }
        }
    }

    // Macro (下段)
    Rectangle {
        y: 110px;
        height: 20px;
        width: 100%;
        Rectangle {
            y: 9px;
            width: 100%;
            height: 2px;
            background: #ccc;
        }

        Rectangle {
            x: (root.macro-chunk-x - root.chunk-radius) * 1px;
            y: (10.0 - root.chunk-radius) * 1px;
            width: (root.chunk-radius * 2.0) * 1px;
            height: (root.chunk-radius * 2.0) * 1px;
            border-radius: root.chunk-radius * 1px;
            background: #2196f3;
            border-width: 2px;
            border-color: #fff;
        }

        TouchArea {
            property <bool> is-pressed: false;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.is-pressed = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    self.is-pressed = false;
                }
                if (self.is-pressed && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move)) {
                    root.macro-ratio-changed(Math.max(0.0, Math.min(self.mouse-x / self.width, 1.0)));
                }
            }
        }

        Text {
            text: "Macro (Total: \{Math.round(root.effective-max)}s)";
            x: 5px;
            y: -10px;
            font-size: 10px;
            color: #666;
        }

        for tag[i] in State.tags: Rectangle {
            property <float> rel-x: tag.vt / root.effective-max;
            x: (rel-x * parent.width / 1px) * 1px - 2px;
            y: 6px;
            width: 4px;
            height: 8px;
            background: #00bcd4;
            opacity: 0.6;

            Text {
                text: tag.label;
                y: 8px;
                font-size: 9px;
                color: #0288d1;
            }
        }
    }
}

export global State {
    in-out property <bool> scrubbing: false;
    in-out property <bool> eraser: false;
    in-out property <bool> playing: false;
    in-out property <float> vt: 0.0;
    in-out property <float> vt-max: 0.0;
    in-out property <bool> chaos-pad-mode: false;
    in-out property <[int]> highlighted-strokes: [];
    in-out property <float> macro-ratio: 0.0;
    in-out property <float> middle-ratio: 0.0;
    in-out property <bool> fullscreen: false;
    in-out property <[TagData]> tags: [];

    in-out property <string> tag-search-query: "";
    in-out property <bool> show-tag-editor: false;
    in-out property <string> tag-name-input: "";
    in-out property <string> active-tag-label: "";
}

export component MainWindow inherits Window {
    title: "TimeLeap Memo (Rust)";
    icon: @image-url("../../Icon/タイムリープメモ_アイコン.svg");
    width: 1280px;
    height: 720px;
    background: #ffffff;
    full-screen: State.fullscreen;
    forward-focus: key-handler;

    init => {
        key-handler.focus();
    }

    // ==========================================
    // 中央スケール定数
    // ==========================================
    in property <float> timeline-max: 3600.0;
    in property <float> middle-scale: 600.0;
    in property <float> micro-scale: 60.0;

    // ==========================================
    // 窓の開始位置計算（全階層の連動の核）
    // ==========================================
    property <float> effective-max: Math.max(1.0, State.vt-max);
    property <float> macro-center: State.macro-ratio * root.effective-max;
    property <float> middle-start: Math.max(0.0, root.macro-center - root.middle-scale / 2.0);
    property <float> middle-center: root.middle-start + (State.middle-ratio * root.middle-scale);
    property <float> micro-start: Math.max(0.0, root.middle-center - root.micro-scale / 2.0);

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "e" || event.text == "E" || event.text == "1") {
                State.eraser = !State.eraser;
                return accept;
            }
            if (event.text == "n" || event.text == "N" || event.text == "3") {
                root.gonow();
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                State.scrubbing = true;
                return accept;
            }
            if (event.text == " ") {
                State.chaos-pad-mode = true;
                root.enter-chaos-pad();
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                root.add-tag();
                return accept;
            }
            if (event.text == "2") {
                State.chaos-pad-mode = !State.chaos-pad-mode;
                if (State.chaos-pad-mode) {
                    root.enter-chaos-pad();
                } else {
                    root.exit-chaos-pad();
                }
                return accept;
            }
            if (event.text == "f" || event.text == "F" || event.text == "F11") {
                State.fullscreen = !State.fullscreen;
                return accept;
            }
            if (event.text == "5") {
                root.add-tag();
                return accept;
            }
            if (event.text == "4" || event.text == Key.LeftArrow) {
                root.jump-tag(-1);
                return accept;
            }
            if (event.text == "6" || event.text == Key.RightArrow) {
                root.jump-tag(1);
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == "b" || event.text == "B") {
                State.scrubbing = false;
                return accept;
            }
            if (event.text == " ") {
                State.chaos-pad-mode = false;
                root.exit-chaos-pad();
                return accept;
            }
            return reject;
        }
    }

    callback pointer-move(Point);
    callback pointer-down(Point);
    callback pointer-up();
    callback toggleplay();
    callback gonow();
    callback scrub(float);
    callback enter-chaos-pad();
    callback exit-chaos-pad();
    callback jump-tag(int); // -1: left, 1: right
    callback confirm-tag-rename(string);
    callback time-changed(float);
    callback segment-selected(int);
    callback worldline-changed(float);
    callback add-tag();

    in property <[StrokeData]> strokes-to-render;
    in property <[SegmentData]> timeline-segments: [];
    out property <float> canvas-width: canvas.width / 1px;
    out property <float> canvas-height: canvas.height / 1px;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        canvas := Rectangle {
            background: #ffffff;
            border-color: #ddd;
            border-width: 1px;
            border-radius: 4px;
            clip: true;

            for stroke in root.strokes-to-render: Path {
                width: 100%;
                height: 100%;
                viewbox-width: root.canvas-width;
                viewbox-height: root.canvas-height;
                commands: stroke.path_data;
                stroke: stroke.color;
                stroke-width: stroke.width;
                opacity: stroke.opacity;
            }

            if State.chaos-pad-mode: Rectangle {
                width: 100%;
                height: 100%;
                background: #2196f333;
                VerticalLayout {
                    padding: 0;
                    spacing: 0;
                    width: 100%;
                    height: 100%;
                    for seg in root.timeline-segments: Rectangle {
                        background: seg.highlighted ? #ff00ff21 : #ffffff28;
                        Text {
                            text: "Worldline ID: \{seg.id}";
                            color: #fff;
                            font-size: 12px;
                            x: 10px;
                            y: 10px;
                        }

                        Path {
                            width: 100%;
                            height: 100%;
    
                            // X座標はキャンバス幅に、Y座標はRust側の基準(100)に合わせる
                            viewbox-width: root.canvas-width;
                            viewbox-height: root.canvas-height / Math.max(1, root.timeline-segments.length);
                            commands: seg.waveform-data;
                            fill: seg.highlighted ? #ff00ff44 : #2196f344;
                        }
                    }
                }
                // Playhead (現在の時間位置を示す縦線)
                Rectangle {
                    x: (State.vt / Math.max(0.01, State.vt-max)) * parent.width - 1px;
                    y: 0;
                    width: 2px;
                    height: 100%;
                    background: #ff0000;
                }
            }

            if State.scrubbing && !State.chaos-pad-mode: Rectangle {
                width: 100%;
                height: 100%;
                background: #2196f333;
                animate background { duration: 150ms; }
                Text {
                    text: "TIME SCRUBBING";
                    color: #2196f3;
                    font-size: 24px;
                    font-weight: 800;
                    opacity: 0.5;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            touch-area := TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if (State.chaos-pad-mode) {
                        if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.down) {
                            let ratio = Math.max(0.0, Math.min(self.mouse-x / self.width, 1.0));
                            // 波形に合わせて全タイムライン（0〜vt-max）をシーク
                            root.time-changed(ratio * State.vt-max);
                            let ratio-y = self.mouse-y / self.height;
                            root.worldline-changed(ratio-y);
                        }
                    } else if (State.scrubbing) {
                        if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                            root.scrub(self.mouse-x / self.width);
                        }
                    } else {
                        if (event.kind == PointerEventKind.down) {
                            root.pointer-down({ x: self.mouse-x / self.width, y: self.mouse-y / self.height });
                        } else if (event.kind == PointerEventKind.move) {
                            root.pointer-move({ x: self.mouse-x / self.width, y: self.mouse-y / self.height });
                        } else if (event.kind == PointerEventKind.up) {
                            root.pointer-up();
                        }
                    }
                }
            }

            // Contextual Tag Label (Flat Design)
            if State.active-tag-label != "": Text {
                x: 15px;
                y: 15px;
                text: State.active-tag-label;
                font-size: 18px;
                font-weight: 800;
                color: #00bcd4;
                opacity: 0.7;
            }
        }

        if State.chaos-pad-mode: FractalTimeline {
            timeline-max: root.effective-max;
            middle-window-size: root.middle-scale;
            micro-window-size: root.micro-scale;
            current-vt: State.vt;
            macro-ratio: State.macro-ratio;
            middle-ratio: State.middle-ratio;
            micro-start: root.micro-start;

            macro-ratio-changed(r) => {
                let snap-r = r > 0.98 ? 1.0 : r;
                State.macro-ratio = snap-r;
            }
            middle-ratio-changed(r) => {
                let snap-r = r > 0.98 ? 1.0 : r;
                State.middle-ratio = snap-r;
            }
            time-changed(t) => {
                root.time-changed(t);
            }
        }

        HorizontalLayout {
            height: 40px;
            spacing: 20px;
            alignment: center;
            Text {
                text: "Virtual Time: \{Math.round(State.vt * 100) / 100}";
                vertical-alignment: center;
            }

            // Control Buttons
            HorizontalLayout {
                spacing: 15px;
                
                // Chaos Pad Toggle
                Rectangle {
                    width: 70px;
                    height: 40px;
                    background: State.chaos-pad-mode ? #9c27b0 : #f3e5f5;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #9c27b0;
                    Text {
                        text: "MULTI";
                        color: State.chaos-pad-mode ? white : #9c27b0;
                        font-weight: 700;
                        font-size: 14px;
                    }
                    TouchArea {
                        clicked => {
                            State.chaos-pad-mode = !State.chaos-pad-mode;
                            if (State.chaos-pad-mode) {
                                root.enter-chaos-pad();
                            } else {
                                root.exit-chaos-pad();
                            }
                        }
                    }
                }

                // Jump Prev Tag
                Rectangle {
                    width: 50px;
                    height: 40px;
                    background: #e0f7fa;
                    border-radius: 6px;
                    Text {
                        text: "◀ T";
                        color: #00838f;
                        font-weight: 700;
                    }
                    TouchArea {
                        clicked => { root.jump-tag(-1); }
                    }
                }

                // Add Tag
                Rectangle {
                    width: 50px;
                    height: 40px;
                    background: #e0f2f1;
                    border-radius: 6px;
                    Text {
                        text: "T +";
                        color: #00695c;
                        font-weight: 700;
                    }
                    TouchArea {
                        clicked => { root.add-tag(); }
                    }
                }

                // Jump Next Tag
                Rectangle {
                    width: 50px;
                    height: 40px;
                    background: #e0f7fa;
                    border-radius: 6px;
                    Text {
                        text: "T ▶";
                        color: #00838f;
                        font-weight: 700;
                    }
                    TouchArea {
                        clicked => { root.jump-tag(1); }
                    }
                }
            }

            Rectangle {
                width: 70px;
                height: 40px;
                background: State.eraser ? #fb8c00 : #2196f3;
                border-radius: 6px;
                Text {
                    text: State.eraser ? "ERASER" : "PEN";
                    color: white;
                    font-weight: 700;
                }

                TouchArea {
                    clicked => {
                        State.eraser = !State.eraser
                    }
                }
            }

            Rectangle {
                width: 70px;
                height: 40px;
                background: State.playing ? #d40000 : #00d478;
                border-radius: 6px;
                Text {
                    text: State.playing ? "PAUSE" : "PLAY";
                    color: white;
                    font-weight: 700;
                }

                TouchArea {
                    clicked => {
                        root.toggleplay()
                    }
                }
            }

            Rectangle {
                width: 60px;
                height: 40px;
                background: #0078d4;
                border-radius: 6px;
                Text {
                    text: "NOW";
                    color: white;
                    font-weight: 700;
                }

                TouchArea {
                    clicked => {
                        root.gonow()
                    }
                }
            }

            // Tag Search
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Search Tags:";
                    vertical-alignment: center;
                    font-size: 12px;
                    color: #666;
                }

                LineEdit {
                    width: 150px;
                    height: 35px;
                    placeholder-text: "Filter...";
                    text <=> State.tag-search-query;
                    accepted => {
                        key-handler.focus();
                    }
                }
            }
        }
    }

    if State.show-tag-editor: Rectangle {
        background: #00000040;
        TouchArea { } // Block clicks behind
        Rectangle {
            width: 300px;
            height: 120px;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ddd;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000020;
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                Text {
                    text: "New Tag Name";
                    font-weight: 700;
                    color: #333;
                }

                input := LineEdit {
                    text <=> State.tag-name-input;
                    accepted => {
                        root.confirm-tag-rename(self.text);
                        State.show-tag-editor = false;
                        key-handler.focus();
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            State.show-tag-editor = false;
                            key-handler.focus();
                        }
                    }

                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            root.confirm-tag-rename(input.text);
                            State.show-tag-editor = false;
                            key-handler.focus();
                        }
                    }
                }
            }

            init => {
                input.focus();
            }
        }
    }
}
